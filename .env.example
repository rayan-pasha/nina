# Copy to .env.local and fill in. .env.local must never be committed.

# Required in production so Open Graph / Twitter image URLs are absolute —
# social crawlers reject relative image paths.
NEXT_PUBLIC_SITE_URL=https://agenq.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave unset locally: the
# tag and the CTA click events only ship when this is present.
NEXT_PUBLIC_GA_ID=

# HubSpot portal ID — the number in app.hubspot.com/…/<id>/ URLs. Same rule:
# the tracking script only loads when this is set.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

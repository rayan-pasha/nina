# Cloudflare Pages reads this file from the site root and applies the rules to
# matching paths. Everything in public/ is copied into the export as-is.

# Next writes the generated Open Graph card to /opengraph-image with no file
# extension, so a static host has nothing to infer the type from and falls back
# to a generic download. Social crawlers ignore anything that isn't an image
# content-type, which would silently kill every link preview.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Hashed build assets are immutable — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
